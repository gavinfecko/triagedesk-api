# Copy to .env for local overrides (the Makefile exports it). Never commit .env.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/triagedesk
DB_USER=triagedesk
DB_PASSWORD=triagedesk
# HS256 signing key for local tokens (dev only, 32+ characters). Production uses JWT_PRIVATE_KEY (RS256).
JWT_SECRET=dev-only-signing-key-change-me-dev-only-signing-key
